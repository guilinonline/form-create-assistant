# ============================================
# FormCreate MCP Server 环境变量配置
# ============================================

# 服务器配置
# 服务端口 (默认: 3001)
PORT=3001

# 监听地址 (默认: 0.0.0.0;生产建议 127.0.0.1——仅本机/平台代理可达,不对外)
# HOST=127.0.0.1

# 访问守卫(双因子:可信来源 IP + 共享密钥;流程引擎 X-Internal-Token 同款)
# 可信来源 IP 白名单(逗号分隔;填平台代理所在主机,IPv6 映射前缀自动归一)
# TRUSTED_IPS=127.0.0.1,::1
# 共享密钥:与平台代理侧 FORM_ASSISTANT_TOKEN 一致;未设=拒绝所有对话请求
# INTERNAL_TOKEN=

# Other Agent 配置
# 自定义 OpenAI 兼容接口的完整 URL (默认: https://api.deepseek.com/v1/chat/completions)
AGENT_API=https://api.deepseek.com/v1/chat/completions

# API 请求超时时间（毫秒）(默认: 180000，即 3 分钟)
AGENT_TIMEOUT=180000

# 默认使用 deepseek 服务
DEFAULT_AGENT=deepseek

# 默认使用 deepseek-flash 模型
DEFAULT_MODEL=deepseek-flash

# 默认 UI 栈(设计器渲染栈;ant-design-vue 路线部署必须设)
DEFAULT_UI_FRAMEWORK=ant-design-vue

# 默认的 token, 配置后调用接口时可以不传
DEFAULT_TOKEN=fc-xxxxxxxxxxxxxxxxxx

# 是否为 FormCreate 设计器高级版, 部分组件和功能只有高级版支持
FORM_CREATE_BUSINESS=false
